<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_sage_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="44dp">

        <!-- Title & Badges Header -->
        <TextView
            android:id="@+id/tvChallengesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Challenges"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvChallengesTitle"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flame_streak" />

            <TextView
                android:id="@+id/tvStreakVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Day Streak"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_forest_dark"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Level Badge -->
        <TextView
            android:id="@+id/tvLevelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            android:background="@drawable/bg_badge_healthy"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Segmented Tabs Row (Daily, Weekly, Badges) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvChallengesTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="4dp"
                android:weightSum="3">

                <!-- Tab 1: Daily (Selected) -->
                <TextView
                    android:id="@+id/tabDaily"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Daily"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_forest_dark"
                    android:background="@drawable/bg_badge_healthy"
                    android:gravity="center" />

                <!-- Tab 2: Weekly -->
                <TextView
                    android:id="@+id/tabWeekly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Weekly"
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_muted"
                    android:gravity="center" />

                <!-- Tab 3: Badges -->
                <TextView
                    android:id="@+id/tabBadges"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Badges"
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_muted"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Today's Tasks Section Header -->
        <TextView
            android:id="@+id/tvTasksHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Tasks"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardTabs"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTasksCompletedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2/4 Completed"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            app:layout_constraintTop_toTopOf="@id/tvTasksHeader"
            app:layout_constraintBottom_toBottomOf="@id/tvTasksHeader"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Challenge Cards List -->
        <LinearLayout
            android:id="@+id/layoutChallengeCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTasksHeader">

            <!-- Challenge 1: Hydration Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChallenge1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/icCh1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_water_drop" />

                        <TextView
                            android:id="@+id/ch1Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hydration Hero"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_dark"
                            android:layout_toEndOf="@id/icCh1"
                            android:layout_marginStart="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Drink 2L of water"
                            android:textSize="14sp"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_below="@id/ch1Title"
                            android:layout_toEndOf="@id/icCh1"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+50 XP"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <!-- Progress Bar Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_text_dark"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCh1"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progress="80"
                        app:trackCornerRadius="5dp"
                        app:trackColor="#E2E8F0"
                        app:indicatorColor="@color/brand_cyan_progress"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogWaterCh1"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Log Water"
                        style="@style/Widget.Impilo.PillButton"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Challenge 2: Garden Walk -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChallenge2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/icCh2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_leaf_logo" />

                        <TextView
                            android:id="@+id/ch2Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Garden Walk"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_dark"
                            android:layout_toEndOf="@id/icCh2"
                            android:layout_marginStart="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inspect all crops for pests"
                            android:textSize="14sp"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_below="@id/ch2Title"
                            android:layout_toEndOf="@id/icCh2"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+30 XP"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <!-- Progress Bar Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_text_dark"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCh2"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progress="100"
                        app:trackCornerRadius="5dp"
                        app:trackColor="#E2E8F0"
                        app:indicatorColor="@color/brand_forest_primary"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompletedCh2"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Completed"
                        style="@style/Widget.Impilo.PillButton"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Challenge 3: Green Thumb -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChallenge3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/icCh3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_flower_bed" />

                        <TextView
                            android:id="@+id/ch3Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Green Thumb"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_dark"
                            android:layout_toEndOf="@id/icCh3"
                            android:layout_marginStart="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plant 1 new vegetable"
                            android:textSize="14sp"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_below="@id/ch3Title"
                            android:layout_toEndOf="@id/icCh3"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+100 XP"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <!-- Progress Bar Row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_forest_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_text_dark"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCh3"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progress="0"
                        app:trackCornerRadius="5dp"
                        app:trackColor="#E2E8F0"
                        app:indicatorColor="@color/brand_forest_primary"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartPlantingCh3"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Start Planting"
                        style="@style/Widget.Impilo.PillButton"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
