<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Green Circle Badge with Animated Checkmark -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCheckBadge"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:cardCornerRadius="44dp"
        app:cardBackgroundColor="@color/brand_forest_primary"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivCheckmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:contentDescription="Success" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account Created!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/brand_forest_dark"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tvSuccessMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You have successfully created an account"
        android:textSize="15sp"
        android:textColor="@color/brand_text_muted"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Continue to Dashboard"
        android:textSize="15sp"
        style="@style/Widget.Impilo.PillButton"
        android:layout_marginTop="24dp" />
</LinearLayout>
