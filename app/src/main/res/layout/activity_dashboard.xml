<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_sage_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="36dp">

        <!-- User Avatar Circle ("TM") -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#52B788"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="TM"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Greeting Header -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sawubona, Thabo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/cardAvatar"
            app:layout_constraintStart_toEndOf="@id/cardAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnNotificationBell" />

        <TextView
            android:id="@+id/tvUserSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Level 12 • Master Grower"
            android:textSize="13sp"
            android:textColor="@color/brand_forest_light"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toEndOf="@id/cardAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnNotificationBell" />

        <!-- Bell Icon Button -->
        <ImageButton
            android:id="@+id/btnNotificationBell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_icon"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notifications"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- StatCards Row (Breathing 3D Elevation) -->
        <LinearLayout
            android:id="@+id/layoutStatCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar">

            <!-- Daily Streak Card -->
            <com.example.impilo23.ui.custom.BreathingCardView
                android:id="@+id/cardStreak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Streak"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_flame_streak" />

                        <TextView
                            android:id="@+id/tvStreakVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 Days"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.example.impilo23.ui.custom.BreathingCardView>

            <!-- Total XP Card -->
            <com.example.impilo23.ui.custom.BreathingCardView
                android:id="@+id/cardXP"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total XP"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_star_xp" />

                        <TextView
                            android:id="@+id/tvXpVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2,450"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.example.impilo23.ui.custom.BreathingCardView>
        </LinearLayout>

        <!-- Health Summary Header -->
        <TextView
            android:id="@+id/tvHealthSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Summary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutStatCards"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btnViewHealthHub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Hub"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="@id/tvHealthSummaryTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvHealthSummaryTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Health Summary Items Row -->
        <LinearLayout
            android:id="@+id/layoutHealthSummaryItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvHealthSummaryTitle">

            <!-- Hydration Summary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_water_drop" />

                <TextView
                    android:id="@+id/tvSummaryWater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.8L / 2.5L"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_dark"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hydration Goal"
                    android:textSize="12sp"
                    android:textColor="@color/brand_forest_primary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Daily Steps Summary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_workout" />

                <TextView
                    android:id="@+id/tvSummarySteps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6,420"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_dark"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Steps"
                    android:textSize="12sp"
                    android:textColor="@color/brand_forest_primary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Garden Tasks Section Header -->
        <TextView
            android:id="@+id/tvGardenTasksTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Garden Tasks"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutHealthSummaryItems"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btnViewGardenHub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See All"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="@id/tvGardenTasksTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvGardenTasksTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Task List Cards -->
        <LinearLayout
            android:id="@+id/layoutTasksList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvGardenTasksTitle">

            <!-- Task Item 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTask1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/cbTask1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvTask1Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Water Spinach Patch"
                            android:textSize="15sp"
                            android:textColor="@color/brand_text_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Due by 10:00 AM"
                            android:textSize="12sp"
                            android:textColor="@color/brand_text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Task Item 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTask2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/cbTask2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvTask2Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Check Soil Moisture"
                            android:textSize="15sp"
                            android:textColor="@color/brand_text_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Due by 12:00 PM"
                            android:textSize="12sp"
                            android:textColor="@color/brand_text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Task Item 3 (Completed State) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTask3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/cbTask3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:checked="true"
                        android:buttonTint="@color/brand_forest_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvTask3Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Harvest Bell Peppers"
                            android:textSize="15sp"
                            android:textColor="@color/brand_forest_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed 8:30 AM"
                            android:textSize="12sp"
                            android:textColor="@color/brand_forest_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Indigenous Plant Quiz Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuizBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/brand_forest_primary"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTasksList">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuizIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#40916C"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkles" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvQuizTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Indigenous Plant Quiz"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="14dp"
                    app:layout_constraintTop_toTopOf="@id/cardQuizIcon"
                    app:layout_constraintStart_toEndOf="@id/cardQuizIcon"
                    app:layout_constraintEnd_toStartOf="@id/btnStartQuiz" />

                <TextView
                    android:id="@+id/tvQuizDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Test your knowledge &amp; earn 50 XP"
                    android:textSize="13sp"
                    android:textColor="#D8F3DC"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvQuizTitle"
                    app:layout_constraintStart_toEndOf="@id/cardQuizIcon"
                    app:layout_constraintEnd_toStartOf="@id/btnStartQuiz" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Start"
                    android:textSize="14sp"
                    android:backgroundTint="#52B788"
                    app:cornerRadius="20dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Hub Navigation Buttons -->
        <LinearLayout
            android:id="@+id/layoutBottomNavs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardQuizBanner">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavHealth"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Health Hub"
                style="@style/Widget.Impilo.PillButton"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavGarden"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Garden Hub"
                style="@style/Widget.Impilo.PillButton"
                android:layout_marginHorizontal="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavChallenges"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Challenges"
                style="@style/Widget.Impilo.PillButton"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Explore Impilo23 Footer Anchor -->
        <TextView
            android:id="@+id/tvExploreFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Impilo23"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutBottomNavs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Loading Overlay -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80FFFFFF"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
