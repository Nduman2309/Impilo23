<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_sage_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="48dp">

        <!-- Top Navigation Header -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Hub"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_dark"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnBell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notifications"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Health StatCards Row -->
        <LinearLayout
            android:id="@+id/layoutStatCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <!-- Water Intake StatCard -->
            <com.example.impilo23.ui.custom.BreathingCardView
                android:id="@+id/cardWaterStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_water_drop" />

                    <TextView
                        android:id="@+id/tvWaterStatVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.8L"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water Intake"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.example.impilo23.ui.custom.BreathingCardView>

            <!-- Kcal Burned StatCard -->
            <com.example.impilo23.ui.custom.BreathingCardView
                android:id="@+id/cardBurnedStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_flame_streak" />

                    <TextView
                        android:id="@+id/tvBurnedStatVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,240"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kcal Burned"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.example.impilo23.ui.custom.BreathingCardView>
        </LinearLayout>

        <!-- Activity Overview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActivityOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutStatCards">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Overview"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <com.example.impilo23.ui.custom.ActivityBarChartView
                    android:id="@+id/barChartView"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Progress Card (Hydration Goal Ring) -->
        <TextView
            android:id="@+id/tvDailyProgressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Progress"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardActivityOverview"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDailyProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDailyProgressTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <com.example.impilo23.ui.custom.DimensionalProgressRing
                    android:id="@+id/progressRing"
                    android:layout_width="100dp"
                    android:layout_height="100dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hydration Goal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark" />

                    <TextView
                        android:id="@+id/tvRingSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="75% of your 2.5L target reached"
                        android:textSize="13sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogWaterPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Log Water"
                        android:textSize="13sp"
                        style="@style/Widget.Impilo.OutlinedPillButton"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Logs Section Header -->
        <TextView
            android:id="@+id/tvRecentLogsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Logs"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardDailyProgress"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSeeAllLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Meal / Activity"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="@id/tvRecentLogsTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvRecentLogsTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Recent Logs Items Container -->
        <LinearLayout
            android:id="@+id/layoutRecentLogsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecentLogsTitle">

            <!-- Item 1: Avocado Toast -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconCard1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="14dp"
                        app:cardBackgroundColor="@color/brand_sage_surface"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_food" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/log1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avocado Toast &amp; Eggs"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark"
                        android:layout_toEndOf="@id/iconCard1"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breakfast • Healthy Fats"
                        android:textSize="13sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/log1Title"
                        android:layout_toEndOf="@id/iconCard1"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:30 AM"
                        android:textSize="12sp"
                        android:textColor="@color/brand_text_muted"
                        android:layout_alignParentEnd="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+420"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/log1Title"
                        android:layout_marginTop="2dp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 2: Morning Yoga -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Impilo.Card"
                android:layout_marginBottom="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconCard2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardCornerRadius="14dp"
                        app:cardBackgroundColor="@color/brand_sage_surface"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_workout" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/log2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Morning Yoga"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark"
                        android:layout_toEndOf="@id/iconCard2"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 mins • Low Intensity"
                        android:textSize="13sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/log2Title"
                        android:layout_toEndOf="@id/iconCard2"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:00 AM"
                        android:textSize="12sp"
                        android:textColor="@color/brand_text_muted"
                        android:layout_alignParentEnd="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+150"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/log2Title"
                        android:layout_marginTop="2dp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Floating Add Meal/Activity Pill Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogActivityPill"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:text="Log Activity"
            android:textSize="15sp"
            style="@style/Widget.Impilo.PillButton"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutRecentLogsList"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
