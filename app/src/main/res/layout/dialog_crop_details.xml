<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/brand_sage_surface"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivCropDetailImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flower_bed"
                android:contentDescription="Crop Picture" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvCropDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomatoes &amp; Basil"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_dark"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvBotanicalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solanum lycopersicum"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="@color/brand_forest_primary"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brand_border"
            android:layout_marginVertical="16dp" />

        <!-- Care Telemetry Grid -->
        <TextView
            android:id="@+id/tvDetailZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌍 Region: Zone 9b • South Africa"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark" />

        <TextView
            android:id="@+id/tvDetailStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 Stage: Flowering &amp; Fruiting Stage"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDetailHarvest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Harvest Countdown: 12 days remaining"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDetailSun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Sunlight Need: 6-8 hours direct sunlight"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDetailWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💧 Watering: Deep root soak every 2 days"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDetails"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Close Inspection Sheet"
            style="@style/Widget.Impilo.PillButton"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
