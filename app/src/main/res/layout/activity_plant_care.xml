<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_sage_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="48dp">

        <!-- Top Navigation Header -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Green Life: Plant Care"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_dark"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/tvLevelBadge" />

        <TextView
            android:id="@+id/tvLevelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 12"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_forest_primary"
            android:background="@drawable/bg_badge_healthy"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Search Guide Input Box -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/ic_sparkles"
            app:startIconTint="@color/brand_text_muted"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/brand_forest_primary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchGuides"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search care tips, crops, soil..."
                android:inputType="text"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Master Gardener Progress Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProgressBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/brand_forest_primary"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tilSearch">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/bannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master Gardener Masterclass"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvXpEarned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50 XP"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#D8F3DC"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapter 2 of 6 Completed"
                    android:textSize="13sp"
                    android:textColor="#D8F3DC"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressGuide"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="33"
                    app:trackCornerRadius="4dp"
                    app:trackColor="#4081C784"
                    app:indicatorColor="@color/white"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardProgressBanner">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_forest_dark"
                    android:background="@drawable/bg_badge_healthy"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSoil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soil &amp; Compost"
                    android:textSize="13sp"
                    android:textColor="@color/brand_text_muted"
                    android:background="@drawable/bg_circle_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipWater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watering"
                    android:textSize="13sp"
                    android:textColor="@color/brand_text_muted"
                    android:background="@drawable/bg_circle_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunlight"
                    android:textSize="13sp"
                    android:textColor="@color/brand_text_muted"
                    android:background="@drawable/bg_circle_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipPest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pest Control"
                    android:textSize="13sp"
                    android:textColor="@color/brand_text_muted"
                    android:background="@drawable/bg_circle_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipHarvest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harvesting"
                    android:textSize="13sp"
                    android:textColor="@color/brand_text_muted"
                    android:background="@drawable/bg_circle_icon"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Chapter 1 Card: Soil & Compost -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/scrollChips">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_flower_bed" />

                    <TextView
                        android:id="@+id/ch1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 1: Soil &amp; Compost"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap1"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch1Title"
                        android:layout_toEndOf="@id/icCap1"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh1Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:checked="true"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose well-draining organic soil for veggies. Blend 60% topsoil, 30% organic compost, and 10% perlite to ensure root aeration and prevent root rot in South African red soils."
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chapter 2 Card: Smart Watering Routine -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_water_drop" />

                    <TextView
                        android:id="@+id/ch2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 2: Smart Watering Systems"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap2"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch2Title"
                        android:layout_toEndOf="@id/icCap2"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh2Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:checked="true"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Perform the 2-inch knuckle soil check. Water deeply at the root base early morning before sunrise to minimize evaporation in summer heat."
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chapter 3 Card: Sunlight & Microclimates -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sun" />

                    <TextView
                        android:id="@+id/ch3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 3: Sunlight &amp; Microclimates"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap3"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch3Title"
                        android:layout_toEndOf="@id/icCap3"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh3Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leafy greens require 4-6 hours of partial morning sun. Tomatoes and peppers require 6-8 hours of direct sunlight. Use shade cloth during intense Highveld midday sun."
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chapter 4 Card: Eco-Friendly Pest Control -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_leaf_logo" />

                    <TextView
                        android:id="@+id/ch4Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 4: Eco Pest Control"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap4"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch4Title"
                        android:layout_toEndOf="@id/icCap4"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh4Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mix organic Neem oil spray with mild liquid soap for natural aphid control. Plant Marigolds and Basil nearby as companion deterrents for garden bugs."
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chapter 5 Card: Pruning & Propagation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap5"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sparkles" />

                    <TextView
                        android:id="@+id/ch5Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 5: Pruning &amp; Propagation"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap5"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch5Title"
                        android:layout_toEndOf="@id/icCap5"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh5Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pinch off top growing tips of herbs to encourage bushier growth. Root tomato suckers in water jars for 10 days to propagate fresh free plants!"
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chapter 6 Card: Harvest & Storage -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChapter6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/icCap6"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_food" />

                    <TextView
                        android:id="@+id/ch6Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chapter 6: Harvest &amp; Storage"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_forest_dark"
                        android:layout_toEndOf="@id/icCap6"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 min read • +25 XP"
                        android:textSize="12sp"
                        android:textColor="@color/brand_forest_primary"
                        android:layout_below="@id/ch6Title"
                        android:layout_toEndOf="@id/icCap6"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp" />

                    <CheckBox
                        android:id="@+id/cbCh6Complete"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:buttonTint="@color/brand_forest_primary"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harvest leafy greens from outer leaves inwards to keep the crop producing. Air-dry rosemary and mint in shade for 7 days to preserve aromatic essential oils."
                    android:textSize="14sp"
                    android:textColor="@color/brand_text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive Smart Watering Calculator Tool -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWaterCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Impilo.Card"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/brand_forest_primary"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardChapter6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Watering Schedule Calculator"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select crop type to calculate optimal watering interval:"
                    android:textSize="13sp"
                    android:textColor="#D8F3DC"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalcGreens"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Greens"
                        android:textSize="11sp"
                        android:backgroundTint="#52B788"
                        app:cornerRadius="16dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalcHerbs"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Herbs"
                        android:textSize="11sp"
                        android:backgroundTint="#4081C784"
                        app:cornerRadius="16dp"
                        android:layout_marginHorizontal="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalcSucculents"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Succulents"
                        android:textSize="11sp"
                        android:backgroundTint="#4081C784"
                        app:cornerRadius="16dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalcResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💧 Recommended: Water every 1-2 days (Keep soil consistently moist)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="#30FFFFFF"
                    android:padding="12dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
