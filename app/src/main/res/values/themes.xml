<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.IMPILO23" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_forest_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_sage_surface</item>
        <item name="colorOnPrimaryContainer">@color/brand_forest_dark</item>
        <item name="colorSecondary">@color/brand_forest_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/brand_sage_bg</item>
        <item name="colorSurface">@color/brand_card_bg</item>
        <item name="colorOnSurface">@color/brand_text_dark</item>
        <item name="colorOnSurfaceVariant">@color/brand_text_muted</item>

        <item name="android:statusBarColor">@color/brand_forest_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.IMPILO23" parent="Base.Theme.IMPILO23" />

    <style name="Widget.Impilo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/brand_card_bg</item>
        <item name="strokeColor">@color/brand_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Impilo.PillButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/brand_forest_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Impilo.OutlinedPillButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/brand_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/brand_text_dark</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>